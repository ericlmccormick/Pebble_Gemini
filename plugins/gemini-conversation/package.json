{
  "name": "pebble-gemini-conversation-plugin",
  "version": "0.1.0",
  "author": "Eric McCormick",
  "pebble": {
    "displayName": "Gemini Conversation",
    "uuid": "2c5edc42-b096-4f76-b284-1f27907e6501",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "projectType": "plugin",
    "configPage": "src/config.html",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "generativelanguage.googleapis.com"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Shared Gemini conversation backend for Pebble apps. Text in, text out; no TTS. User-supplied Gemini API key.",
      "script": "src/plugin/index.js",
      "definesPermissions": [
        {
          "name": "GeminiConverse",
          "label": "Send questions to Google Gemini and receive responses",
          "kind": "exfiltrating"
        },
        {
          "name": "GeminiRead",
          "label": "Read Gemini plugin configuration status",
          "kind": "read"
        }
      ],
      "sources": [
        {
          "category": "agent",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean"
            ]
          },
          "supportsMultiple": false,
          "suggestedRefreshIntervalSec": 120,
          "callerPermissions": [
            "GeminiRead"
          ]
        }
      ],
      "actions": [
        {
          "name": "conversation",
          "description": "Send text to Gemini. Returns text and a reusable conversation_id. Supports optional instructions and model.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "conversation_id": {
                "type": "string"
              },
              "instructions": {
                "type": "string",
                "maxLength": 1000
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "callerPermissions": [
            "GeminiConverse"
          ]
        },
        {
          "name": "get_config",
          "description": "Get safe settings and configuration status (never credentials).",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "callerPermissions": [
            "GeminiRead"
          ]
        },
        {
          "name": "list_models",
          "description": "List text generation models offered to the configured Gemini API key. Excludes live-audio, TTS, images and embeddings.",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "callerPermissions": [
            "GeminiRead"
          ]
        },
        {
          "name": "clear_conversation",
          "description": "Forget a conversation_id on this phone, or all conversations if all=true.",
          "parameters": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string"
              },
              "all": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "callerPermissions": [
            "GeminiConverse"
          ]
        }
      ]
    }
  }
}
